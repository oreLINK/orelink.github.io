---
// Certifications : une petite carte presque carrée par certification, en grille. Toute
// la carte mène à la certification en ligne (si `url` est renseignée). Les certifications expirées
// passent après les autres, en retrait (sans verre, logo en noir et blanc) mais toujours lisibles.
import SectionHead from '../SectionHead.astro';
import Repli from '../Repli.astro';
import OrgMark from '../OrgMark.astro';
import Icon from '../Icon.astro';
import { dateLisible, ordre, plusRecentsDabord } from '../../lib/dates';
import { reglages } from '../../lib/reglages';
import { liste } from '../../lib/contenu';
import { langueDe } from '../../lib/i18n';

interface Props {
  titre: string;
}
const { titre } = Astro.props;
const langue = langueDe(Astro.url);
const { t } = reglages(langue);
const aujourdhui = new Date().toISOString().slice(0, 7);
const estExpiree = (c: { expiration?: string }) => !!c.expiration && ordre(c.expiration) < ordre(aujourdhui);
const toutes = plusRecentsDabord(await liste('certifications', langue), (c) => c.obtention);
const certifications = [...toutes.filter((c) => !estExpiree(c)), ...toutes.filter(estExpiree)];
---

{
  certifications.length > 0 && (
    <section class="section" id="certifications" aria-labelledby="titre-certifications">
      <SectionHead id="certifications" titre={titre} nombre={certifications.length} />
      <Repli nombre={certifications.length}>
        <ol class="tiles certs">
          {certifications.map((c) => {
            const expiree = estExpiree(c);
            return (
              <li class:list={['tile glass cert reveal', { 'is-expired': expiree }]}>
                <div class="cert-top">
                  <OrgMark name={c.organisme} logo={c.logo} />
                  {c.url && <Icon name="external" class="icon-sm cert-ext" />}
                </div>
                <h3 class="cert-title">
                  {c.url ? <a href={c.url} title={c.identifiant && `${t.identifiant} : ${c.identifiant}`}>{c.nom}</a> : c.nom}
                </h3>
                <p class="cert-org">{c.organisme}</p>
                <p class="cert-when">
                  {dateLisible(c.obtention, langue)}
                  {c.expiration && <span class="cert-exp">{`${expiree ? t.expireeEn : t.expireEn} ${dateLisible(c.expiration, langue)}`}</span>}
                </p>
              </li>
            );
          })}
        </ol>
      </Repli>
    </section>
  )
}
