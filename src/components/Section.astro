---
import BottomSheet from './BottomSheet.astro';

interface Props {
  id: string;         // ex. "experiences"
  num: string;        // ex. "02"
  title: string;      // ex. "Expériences"
  count: number;      // nombre total d'entrées
  active?: boolean;   // le nœud porte-t-il le signal ? (poste actuel)
  voirLabel?: string; // libellé du bouton (défaut : "voir tout")
}
const { id, num, title, count, active = false, voirLabel = 'voir tout' } = Astro.props;
---

<section class={`stage node${active ? ' is-active' : ''}`} id={id}>
  <div class="eyebrow"><span class="num">{num}</span> · {title}</div>
  <h2>{title}</h2>

  {/* carte résumé : la dernière entrée, toujours visible */}
  <slot name="summary" />

  {/* bouton d'ouverture du panneau, seulement s'il y a plus d'une entrée */}
  {count > 1 && (
    <button class="voir-tout" data-open-sheet={id}>
      {voirLabel} ({count})
      <span class="arrow" aria-hidden="true">↧</span>
    </button>
  )}

  {/* panneau : toutes les entrées détaillées */}
  <BottomSheet id={id} eyebrow={`${num} · ${title}`} title={`Toutes mes ${title.toLowerCase()}`} count={count}>
    <slot name="details" />
  </BottomSheet>
</section>
