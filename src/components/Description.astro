---
// Description d'une tuile, repliée à 3 lignes (la dernière s'estompe) avec « Voir plus » / « Voir moins ».
// Une ligne vide sépare deux paragraphes. Sans JavaScript, le texte s'affiche en entier ; le bouton
// n'apparaît que si le texte dépasse.
import { reglages } from '../lib/reglages';
import { langueDe } from '../lib/i18n';

interface Props {
  text: string;
}
const { text } = Astro.props;
const { t } = reglages(langueDe(Astro.url));
const paragraphes = text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<div class="more" data-more>
  <div class="entry-text">
    {paragraphes.map((p) => <p>{p}</p>)}
  </div>
  <button class="more-toggle" type="button" aria-expanded="false" data-label-more={t.voirPlus} data-label-less={t.voirMoins} hidden>{t.voirPlus}</button>
</div>
