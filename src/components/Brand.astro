---
// Le logo « ore_link » en snake_case : le séparateur en couleur d'accent (textes dans site.json → logo).
import { site } from '../lib/reglages';

interface Props {
  size?: 'lg' | 'sm';
}
const { size = 'sm' } = Astro.props;
const { avant, separateur, apres } = site.logo;
---

<span class:list={['brand', `is-${size}`]} role="img" aria-label={`${avant}${separateur}${apres}`}>
  <span aria-hidden="true">{avant}<span class="brand-sep">{separateur}</span>{apres}</span>
</span>
