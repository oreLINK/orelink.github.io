---
// Projets : une tuile par projet, en grille sur grand écran.
import { getCollection } from 'astro:content';
import SectionHead from '../SectionHead.astro';
import Repli from '../Repli.astro';
import ProjetCard from '../ProjetCard.astro';
import { trierProjets } from '../../lib/projets';

interface Props {
  titre: string;
}
const { titre } = Astro.props;
const projets = trierProjets(await getCollection('projets'));
---

{
  projets.length > 0 && (
    <section class="section" id="projets" aria-labelledby="titre-projets">
      <SectionHead id="projets" titre={titre} nombre={projets.length} />
      <Repli nombre={projets.length}>
        <ul class="tiles is-grid">
          {projets.map((p) => (
            <li class="reveal">
              <ProjetCard projet={p} />
            </li>
          ))}
        </ul>
      </Repli>
    </section>
  )
}
