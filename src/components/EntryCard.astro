---
import { moisLisible, periode } from '../lib/dates';

type Kind = 'experience' | 'formation' | 'projet' | 'associatif';
interface Props {
  kind: Kind;
  variant: 'summary' | 'detail';
  entry: Record<string, any>;
}
const { kind, variant, entry } = Astro.props;
const detail = variant === 'detail';

// Normalisation en un modèle d'affichage commun selon le type
let titre = '';
let org = '';
let dateDebut: string | null = null;
let dateFin: string | null = null;
let dateSimple: string | null = null; // pour les projets (une seule date)
let mention = '';
let puces: string[] = [];
let stack: string[] = [];
let liens: { label: string; url: string }[] = [];

if (kind === 'experience') {
  titre = entry.poste;
  org = [entry.entreprise, entry.lieu].filter(Boolean).join(' · ');
  dateDebut = entry.dateDebut; dateFin = entry.dateFin;
  puces = entry.missions ?? []; stack = entry.stack ?? [];
} else if (kind === 'formation') {
  titre = entry.diplome;
  org = [entry.etablissement, entry.lieu].filter(Boolean).join(' · ');
  dateDebut = entry.dateDebut; dateFin = entry.dateFin;
  mention = entry.mention ?? ''; puces = entry.details ?? [];
} else if (kind === 'projet') {
  titre = entry.nom;
  org = entry.role ?? '';
  dateSimple = entry.date;
  puces = entry.description ?? []; stack = entry.stack ?? [];
  if (entry.lien) liens.push({ label: 'démo ↗', url: entry.lien });
  if (entry.repo) liens.push({ label: 'code ↗', url: entry.repo });
} else if (kind === 'associatif') {
  titre = entry.role;
  org = [entry.organisation, entry.lieu].filter(Boolean).join(' · ');
  dateDebut = entry.dateDebut; dateFin = entry.dateFin;
  puces = entry.details ?? [];
}

const enCours = dateFin === null && dateSimple === null;
const dateTexte = dateSimple !== null ? moisLisible(dateSimple) : periode(dateDebut!, dateFin);
---

<article class={`card ${variant}`}>
  <div class="card-head">
    <div>
      <h3 class="card-title">{titre}</h3>
      {org && <div class="card-org">{org}</div>}
    </div>
    <div class="card-date">
      {enCours
        ? <>{dateTexte.replace(' — présent', ' — ')}<span class="now">présent</span></>
        : dateTexte}
    </div>
  </div>

  {mention && <div class="mention" style="margin-top:.5rem">{mention}</div>}
  {entry.resume && <p class="card-resume">{entry.resume}</p>}

  {detail && puces.length > 0 && (
    <ul class="detail-list">
      {puces.map((p) => <li>{p}</li>)}
    </ul>
  )}

  {detail && stack.length > 0 && (
    <div class="tags">
      {stack.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}

  {detail && liens.length > 0 && (
    <div class="card-links">
      {liens.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
    </div>
  )}
</article>
