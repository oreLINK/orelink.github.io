---
// Tuile d'un billet : date, temps de lecture, titre, résumé et projet lié. Toute la tuile
// mène au billet ; la pastille du projet, au-dessus, mène à sa fiche (ou à la page Projets, selon
// l'affichage). `compact` : sans le résumé.
import { getEntry } from 'astro:content';
import { jourLisible } from '../lib/dates';
import { url } from '../lib/paths';
import { lienProjet } from '../lib/projets';
import { reglages } from '../lib/reglages';
import { langueDe } from '../lib/i18n';
import type { Billet } from '../lib/billets';

interface Props {
  billet: Billet;
  compact?: boolean;
  /** false sur la fiche d'un projet : le projet lié est celui de la page. */
  avecProjet?: boolean;
}
const { billet: b, compact = false, avecProjet = true } = Astro.props;
const langue = langueDe(Astro.url);
const { t } = reglages(langue);
const projet = avecProjet && b.projet ? await getEntry('projets', b.projet) : undefined;
const versProjet = projet && lienProjet(projet.id, langue);
const Pastille = versProjet ? 'a' : 'span'; // sans fiche ni page Projets, le projet n'est pas un lien
---

<article class:list={['tile glass post', { 'is-compact': compact }]}>
  <p class="post-meta">
    <time datetime={b.date}>{jourLisible(b.date, langue)}</time>
    <span>{b.minutes} {t.minDeLecture}</span>
    {!b.traduit && <span class="post-lang" lang="fr">{t.enFrancais}</span>}
  </p>
  <h3 class="post-title"><a href={url(`articles/${b.id}/`, langue)} lang={b.traduit ? undefined : 'fr'}>{b.titre}</a></h3>
  {!compact && <p class="post-text" lang={b.traduit ? undefined : 'fr'}>{b.resume}</p>}
  {
    projet && (
      <div class="post-foot">
        <Pastille class="project-chip" href={versProjet}>
          <span class="app-icon is-xs" style={projet.data.couleur && `--c: ${projet.data.couleur}`} aria-hidden="true">{projet.data.titre[0]}</span>
          <span><span class="visually-hidden">{t.projetLie} : </span>{projet.data.titre}</span>
        </Pastille>
      </div>
    )
  }
</article>
