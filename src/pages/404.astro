---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/paths';
import { reglages } from '../lib/reglages';

// Une seule page 404 pour tout le site (GitHub Pages), dans la langue par défaut.
const { t } = reglages('fr');
---

<Base title={t.introuvableTitre} description={t.introuvableTexte}>
  <main id="contenu" class="notfound">
    <p class="code">404</p>
    <h1>{t.introuvableTitre}</h1>
    <p>{t.introuvableTexte}</p>
    <a class="btn" href={url()}><Icon name="arrow-left" class="icon-sm" /> {t.retourAccueil}</a>
  </main>
</Base>
