---
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import Icon from '../components/Icon.astro';
import Brand from '../components/Brand.astro';
import Drapeau from '../components/Drapeau.astro';
import Printemps from '../components/habillages/Printemps.astro';
import Ete from '../components/habillages/Ete.astro';
import Automne from '../components/habillages/Automne.astro';
import Hiver from '../components/habillages/Hiver.astro';
import Halloween from '../components/habillages/Halloween.astro';
import Noel from '../components/habillages/Noel.astro';
import NouvelAn from '../components/habillages/NouvelAn.astro';
import FeteMusique from '../components/habillages/FeteMusique.astro';
import { url, asset } from '../lib/paths';
import { reglages, themes } from '../lib/reglages';
import { billets } from '../lib/billets';
import { LANGUES, cheminSansLangue, langueDe, type Langue } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  /** Rubrique de la page, marquée dans la navigation du haut. */
  rubrique?: 'profil' | 'projets' | 'billets';
  /** Page non répertoriée : les moteurs de recherche ne l'indexent pas. */
  noindex?: boolean;
}
const langue = langueDe(Astro.url);
const { site, profil, t, affichage } = reglages(langue);
const { title = site.meta.titre, description = site.meta.description, rubrique, noindex = false } = Astro.props;
// Navigation entre les rubriques affichées (site.json → affichage) ; « Billets » seulement s'il y en a
// de publiés. Avec une seule rubrique, pas de navigation.
const avecBillets = (await billets(langue)).length > 0;
const rubriques = [
  { id: 'profil', label: t.navProfil, href: url('', langue) },
  ...(affichage.pageProjets ? [{ id: 'projets', label: t.navProjets, href: url('projets/', langue) }] : []),
  ...(avecBillets ? [{ id: 'billets', label: t.navBillets, href: url('articles/', langue) }] : []),
];
const flux = url('articles/rss.xml', langue);
// Sur le profil, le grand logo tient lieu de logo du haut : d'une page à l'autre, l'un se change en
// l'autre (view-transition-name « logo », global.css).
const logoEnHaut = !(rubrique === 'profil' && profil.pseudo);
const canonical = new URL(Astro.url.pathname, Astro.site);
// La même page dans chaque langue (sélecteur de langue et liens hreflang).
const chemin = cheminSansLangue(Astro.url);
const versions = (Object.keys(LANGUES) as Langue[]).map((code) => ({ code, ...LANGUES[code], href: url(chemin, code) }));
// Thèmes d'habillage (src/data/themes.json, voir THEMES.md), choisis dans le navigateur d'après la date,
// par ordre de priorité : spéciaux, puis récurrents, puis saisons.
const sansNom = <T extends { nom: string }>({ nom, ...t }: T) => t;
const habillages = {
  forcer: themes.forcer,
  speciaux: themes.speciaux.map(sansNom),
  annuels: [...themes.recurrents, ...themes.saisons].map((t) => ({ ...sansNom(t), habillage: t.id })),
};
const accents = `--accent-light: ${site.couleurs.accentClair}; --accent-dark: ${site.couleurs.accentSombre};`;
---

<!doctype html>
<html lang={langue} style={accents}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {versions.map((v) => <link rel="alternate" hreflang={v.code} href={new URL(v.href, Astro.site)} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {profil.photo && <meta property="og:image" content={new URL(asset(profil.photo), Astro.site)} />}
    <meta name="theme-color" content="#F4F5F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1014" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('icons/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('icons/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('icons/apple-touch-icon.png')} />
    {avecBillets && <link rel="alternate" type="application/rss+xml" title={`${t.billetsTitre} · ${profil.prenom} ${profil.nom}`} href={flux} />}

    {/* Avant le premier rendu : thème choisi pendant la visite, pour éviter un flash de la mauvaise
        couleur. Sans choix, le thème est celui du système (voir ui.ts). Arrivée par une transition
        de page : le profil s'affiche sans attendre l'apparition au défilement, pour que le logo
        soit visible au bout de son déplacement. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      addEventListener('pagereveal', (e) => e.viewTransition && document.documentElement.classList.add('vt-arrivee'));
      try {
        localStorage.removeItem('orelink.theme'); // ancien choix gardé d'une visite à l'autre
        const theme = sessionStorage.getItem('orelink.theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>

    {/* Thème d'habillage du moment, posé avant le premier rendu : le premier thème actif en période
        parmi les spéciaux (dates AAAA-MM-JJ), puis les récurrents et les saisons (MM-JJ, chaque année).
        `?theme=<id>` (ou `?theme=aucun`) dans l'adresse permet d'en prévisualiser un à toute date. */}
    <script is:inline define:vars={{ habillages }}>
      (() => {
        let choix = null;
        try {
          choix = new URLSearchParams(location.search).get('theme');
        } catch {}
        if (choix === null) choix = habillages.forcer;
        const tous = [...habillages.speciaux, ...habillages.annuels];
        let theme;
        if (choix) {
          theme = tous.find((t) => t.id === choix);
        } else {
          const d = new Date();
          const jour = (d.getMonth() + 1) * 100 + d.getDate(); // MMJJ
          const date = d.getFullYear() * 10000 + jour; // AAAAMMJJ
          const n = (texte) => Number(texte.replaceAll('-', ''));
          const enPeriode = (t, x) => {
            const debut = n(t.debut);
            const fin = n(t.fin);
            return t.actif && (debut <= fin ? debut <= x && x <= fin : x >= debut || x <= fin);
          };
          theme = habillages.speciaux.find((t) => enPeriode(t, date)) ?? habillages.annuels.find((t) => enPeriode(t, jour));
        }
        if (!theme) return;
        const html = document.documentElement;
        html.dataset.habillage = theme.habillage;
        html.style.setProperty('--accent-light', theme.accentClair);
        html.style.setProperty('--accent-dark', theme.accentSombre);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t.allerAuContenu}</a>
    <div class="backdrop" aria-hidden="true">
      <span></span><span></span>
      <Printemps /><Ete /><Automne /><Hiver /><Halloween /><Noel /><NouvelAn /><FeteMusique />
    </div>
    <Icons />

    <div class="page">
      <header class="topbar">
        {logoEnHaut && <a class="brand-link" href={url('', langue)} aria-label={`${site.logo.avant}${site.logo.separateur}${site.logo.apres}, ${t.retourAccueil}`}><Brand /></a>}
        {
          rubriques.length > 1 && (
            <nav class="mainnav glass" aria-label={t.navigation}>
              {rubriques.map((r) => <a href={r.href} aria-current={r.id === rubrique ? 'page' : undefined}>{r.label}</a>)}
            </nav>
          )
        }
        <div class="topbar-end">
          <button class="icon-btn glass lang-switch" type="button" popovertarget="menu-langue" aria-label={t.changerDeLangue} title={t.changerDeLangue}>
            <Drapeau code={LANGUES[langue].drapeau} />
          </button>
          <div class="lang-menu glass" id="menu-langue" popover data-lang-menu>
            <ul>
              {versions.map((v) => (
                <li>
                  <a href={v.href} hreflang={v.code} lang={v.code} aria-current={v.code === langue ? 'page' : undefined}>
                    <Drapeau code={v.drapeau} />
                    <span>{v.nom}</span>
                    {v.code === langue && <Icon name="check" class="icon-sm" />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <button class="icon-btn glass theme-toggle" type="button" aria-label={t.themeSombre} data-theme-toggle data-label-light={t.themeClair} data-label-dark={t.themeSombre}>
            <svg class="icon i-moon" aria-hidden="true"><use href="#i-moon" /></svg>
            <svg class="icon i-sun" aria-hidden="true"><use href="#i-sun" /></svg>
          </button>
        </div>
      </header>

      <slot />

      <footer class="footer">
        <Brand />
        <nav class="footer-links" aria-label={t.liensExternes}>
          {profil.liens.linkedin && <a class="icon-btn glass" href={profil.liens.linkedin} rel="me" aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a>}
          {profil.liens.github && <a class="icon-btn glass" href={profil.liens.github} rel="me" aria-label="GitHub" title="GitHub"><Icon name="github" /></a>}
          {avecBillets && <a class="icon-btn glass" href={flux} aria-label={t.fluxRss} title={t.fluxRss}><Icon name="rss" /></a>}
          {site.piedDePage.lienCodeDuSite && <a class="icon-btn glass" href={site.piedDePage.lienCodeDuSite} aria-label={t.codeDuSite} title={t.codeDuSite}><Icon name="code" /></a>}
        </nav>
      </footer>
    </div>

    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
