---
// Drapeau d'une langue, dessiné en SVG (les émojis drapeaux ne s'affichent pas sous Windows).
// Tous sont cadrés en 3:2 ; le drapeau britannique, en 2:1, est recadré au centre.
interface Props {
  code: 'fr' | 'en' | 'es';
}
const { code } = Astro.props;
// Un drapeau peut paraître plusieurs fois sur une page : identifiant propre à chaque exemplaire.
const clip = `drapeau-en-${Math.random().toString(36).slice(2, 8)}`;
---

{code === 'fr' && (
  <svg class="flag" viewBox="0 0 3 2" aria-hidden="true" focusable="false">
    <path fill="#002654" d="M0 0h1v2H0z" />
    <path fill="#FFFFFF" d="M1 0h1v2H1z" />
    <path fill="#CE1126" d="M2 0h1v2H2z" />
  </svg>
)}
{code === 'en' && (
  <svg class="flag" viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <clipPath id={clip}><path d="M30 15h30v15zv15H0zH0V0zV0h30z" /></clipPath>
    <path fill="#012169" d="M0 0h60v30H0z" />
    <path stroke="#FFFFFF" stroke-width="6" d="M0 0l60 30m0-30L0 30" />
    <path stroke="#C8102E" stroke-width="4" d="M0 0l60 30m0-30L0 30" clip-path={`url(#${clip})`} />
    <path stroke="#FFFFFF" stroke-width="10" d="M30 0v30M0 15h60" />
    <path stroke="#C8102E" stroke-width="6" d="M30 0v30M0 15h60" />
  </svg>
)}
{code === 'es' && (
  <svg class="flag" viewBox="0 0 3 2" aria-hidden="true" focusable="false">
    <path fill="#AA151B" d="M0 0h3v2H0z" />
    <path fill="#F1BF00" d="M0 .5h3v1H0z" />
  </svg>
)}
