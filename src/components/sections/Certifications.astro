---
// Licences et certifications : une tuile par certification.
import SectionHead from '../SectionHead.astro';
import Repli from '../Repli.astro';
import OrgMark from '../OrgMark.astro';
import Tags from '../Tags.astro';
import Icon from '../Icon.astro';
import { dateLisible, ordre, plusRecentsDabord } from '../../lib/dates';
import { reglages } from '../../lib/reglages';
import { liste } from '../../lib/contenu';
import { langueDe } from '../../lib/i18n';

interface Props {
  titre: string;
}
const { titre } = Astro.props;
const langue = langueDe(Astro.url);
const { t } = reglages(langue);
const certifications = plusRecentsDabord(await liste('certifications', langue), (c) => c.obtention);
const aujourdhui = new Date().toISOString().slice(0, 7);
---

{
  certifications.length > 0 && (
    <section class="section" id="certifications" aria-labelledby="titre-certifications">
      <SectionHead id="certifications" titre={titre} nombre={certifications.length} />
      <Repli nombre={certifications.length}>
        <ol class="tiles">
          {certifications.map((c) => (
            <li class="tile glass entry reveal">
              <OrgMark name={c.organisme} logo={c.logo} />
              <div class="entry-body">
                <div class="entry-top">
                  <h3 class="entry-title">{c.nom}</h3>
                  <span class="entry-when">{dateLisible(c.obtention, langue)}</span>
                </div>
                <p class="entry-org">{c.organisme}</p>
                <p class="entry-meta">
                  {t.delivreeEn} {dateLisible(c.obtention, langue)}
                  {c.expiration && <> · {ordre(c.expiration) < ordre(aujourdhui) ? t.expireeEn : t.expireEn} {dateLisible(c.expiration, langue)}</>}
                </p>
                {c.identifiant && <p class="entry-meta">{t.identifiant} : {c.identifiant}</p>}
                <Tags items={c.competences} />
                {c.url && (
                  <div class="entry-links">
                    <a class="btn btn-soft" href={c.url}>{t.afficherCertification} <Icon name="external" class="icon-sm" /></a>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </Repli>
    </section>
  )
}
