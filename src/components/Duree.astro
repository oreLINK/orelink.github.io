---
// Durée « 2 ans 8 mois », calculée au build et tenue à jour dans le navigateur pour ce qui est en
// cours (src/scripts/ui.ts), sans avoir à republier le site chaque mois.
import { duree } from '../lib/dates';

interface Props {
  debut: string;
  fin: string | null;
}
const { debut, fin } = Astro.props;
---

<span class="nowrap" data-duree-debut={fin === null ? debut : undefined}>{duree(debut, fin)}</span>
