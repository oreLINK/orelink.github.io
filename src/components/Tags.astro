---
import { reglages } from '../lib/reglages';
import { langueDe } from '../lib/i18n';

interface Props {
  items: string[];
  label?: string;
}
const { items, label = reglages(langueDe(Astro.url)).t.competences } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="tags" aria-label={label}>
      {items.map((t) => <li>{t}</li>)}
    </ul>
  )
}
